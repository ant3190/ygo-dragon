{
  "name": "ygo-dragon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:client": "vite --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc -b && vite build",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "resources:sync": "node --env-file-if-exists=.env scripts/sync.mjs",
    "test:duel": "node --env-file-if-exists=.env scripts/smoke-duel.mjs",
    "test:room": "node --env-file-if-exists=.env scripts/smoke-room.mjs"
  },
  "dependencies": {
    "adm-zip": "0.5.16",
    "lucide-react": "0.468.0",
    "ocgcore-wasm": "0.1.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.34.5",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
