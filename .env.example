# Node 24+ / Docker. 数据放在项目外；可以直接复用已有 neos 数据中的卡图。
YGO_DATA_DIR=/mnt/data/ygo-dragon
YGO_PORT=18081
YGO_HOST=0.0.0.0
YGO_AUTO_UPDATE=1
YGO_DOWNLOAD_CONCURRENCY=4
YGO_CHECK_INTERVAL_HOURS=6
# 可选，自建镜像优先，值为逗号分隔的完整 URL；不要填浏览器访问地址。
# YGO_DATABASE_URLS=https://your-mirror/cards.cdb,https://cdncf.moecube.com/ygopro-database/zh-CN/cards.cdb
# YGO_IMAGE_BASES=https://your-mirror/pics,https://cdncf.moecube.com/images/ygopro-images-zh-CN
# 规则脚本可使用自己部署的源；版本接口返回 {"sha":"40位Git提交哈希"}。
# YGO_SCRIPTS_VERSION_URL=https://your-mirror/scripts-version.json
# YGO_SCRIPTS_ARCHIVE_URLS=https://your-mirror/CardScripts/{sha}.zip,https://codeload.github.com/ProjectIgnis/CardScripts/zip/{sha}
# 现有 neos 数据目录（只读复用卡图），其下包含 files/images/...。
# YGO_LEGACY_DATA_DIR=/mnt/data/neos-data
# 公网部署且反代跨域时填允许的 Origin，逗号分隔；默认只允许同源 WebSocket。
# YGO_ALLOWED_ORIGINS=https://duel.example.com
